# Local development values only. Copy to .env and change the passwords before
# starting the stack. Never commit the populated .env file.

# PostgreSQL / TimescaleDB
POSTGRES_USER=factorypulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=factorypulse
DATABASE_URL=postgresql://factorypulse:change-me-local-only@localhost:5432/factorypulse

# Demo-user password. Set this before running `make seed`.
DEMO_USER_PASSWORD=replace-with-a-local-password-of-at-least-12-characters

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# MQTT development broker
MQTT_HOST=localhost
MQTT_PORT=1883

# Simulator settings (read by services/simulator)
SIM_DATA_DIR=data/processed
SIM_REPLAY_RATE_HZ=10
SIM_MACHINE_COUNT=-1
SIM_TRANSPORT_TYPE=mqtt
SIM_MQTT_BROKER=localhost
SIM_MQTT_PORT=1883
SIM_MQTT_TOPIC=factorypulse/telemetry
SIM_HTTP_TARGET_URL=http://localhost:8000/api/v1/telemetry
SIM_INJECT_FAULTS=false
SIM_FAULT_PROBABILITY=0.05

# Ingestion settings (read by services/ingestion)
INGEST_DATABASE_URL=postgresql://factorypulse:change-me-local-only@localhost:5432/factorypulse
INGEST_MQTT_BROKER=localhost
INGEST_MQTT_PORT=1883
INGEST_MQTT_TOPIC=factorypulse/telemetry
INGEST_REDIS_URL=redis://localhost:6379/0
INGEST_BATCH_SIZE=500
INGEST_FLUSH_INTERVAL_SECONDS=1.0
INGEST_API_HOST=0.0.0.0
INGEST_API_PORT=8000

# Application authentication placeholder. Generate a unique local value.
AUTH_SECRET_KEY=replace-with-a-random-local-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional dataset source override. NASA currently does not provide a stable
# C-MAPSS download URL; the checkout includes data/raw/train_FD001.txt.
CMAPSS_URL=
