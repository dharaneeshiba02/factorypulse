# =============================================
# FactoryPulse Environment Configuration
# Copy to .env and fill in secrets
# =============================================
# Database (TimescaleDB)
DB_USER=factorypulse
DB_PASS=fp_dev_2024
DB_NAME=factorypulse
DB_HOST=timescaledb
# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# MQTT Broker
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
# Simulator
REPLAY_SPEED=10
# Copilot LLM
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6
# Qdrant Vector Store
QDRANT_HOST=qdrant
QDRANT_PORT=6333
